// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username     String    @unique
  password     String?
  jwtValidFrom DateTime  @default(now()) // support revoke token
  lastLoginAt  DateTime?
  blocked      Boolean   @default(false)
  role         Role      @default(STUDENT)

  // Relations
  student  Student?
  operator Operator?
  blockchainTransactions BlockchainTransaction[] // Added relation for blockchain transactions
  notifications Notification[] // Added relation for notifications
}

enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
}

model Student {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId  String
  firstName  String
  lastName   String
  avatarUrl  String?
  dob        DateTime
  enrollYear Int
  major      String
  email      String
  phone      String?
  address    String?

  // Relations
  userId             String                                   @unique @db.Uuid
  user               User                                     @relation(fields: [userId], references: [id])
  bookings           RoomBooking[]
  forms              AdministrativeProceduresFormSubmission[]
  eventRegistrations EventRegistration[]
}

model Operator {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  avatarUrl String?
  email     String
  phone     String?

  // Relations
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  bookings                  RoomBooking[]
  forms                     AdministrativeProceduresForm[]
  formsHandled              AdministrativeProceduresFormSubmission[]
  events                    Event[]
  eventRegistrationsHandled EventRegistration[]                      @relation("EventRegistrationHandler")
}

model Room {
  roomId      String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  capacity    Int
  location    String
  type        RoomType
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  timeSlots RoomTimeSlot[]
  bookings  RoomBooking[]

  @@index([roomId])
}

enum RoomType {
  CLASSROOM
  LAB
  EVENT
}

model RoomTimeSlot {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startTime DateTime
  endTime   DateTime
  dowsBit   Int

  // Relations
  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [roomId])
}

model RoomBooking {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startTime DateTime
  endTime   DateTime
  duration  Int
  purpose   String

  handleAt DateTime?
  remarks  String?

  attendees Int?

  isRecurring Boolean @default(false)

  status RoomBookingStatus @default(PENDING)

  // Relations
  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [roomId])

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id])

  handleByOperatorId String?   @db.Uuid
  handleBy           Operator? @relation(fields: [handleByOperatorId], references: [id])

  recurringPattern RecurringPattern?

  @@index([roomId, startTime, endTime])
}

enum RoomBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model RecurringPattern {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startDate DateTime
  endDate   DateTime
  frequency Frequency
  interval  Int
  dowsBit   Int

  // Relations
  bookingId String      @unique @db.Uuid
  booking   RoomBooking @relation(fields: [bookingId], references: [id])
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model AdministrativeProceduresForm {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  data Json

  name                 String  @unique
  slug                 String  @unique
  description          String
  type                 String
  isActive             Boolean @default(true)
  fileUrl              String?
  allowEditAfterSubmit Boolean @default(false)
  requireApproval      Boolean @default(false)

  metadata Json?

  // Relations
  submissions         AdministrativeProceduresFormSubmission[]
  createdByOperatorId String?                                  @db.Uuid
  createdBy           Operator?                                @relation(fields: [createdByOperatorId], references: [id])
}

model AdministrativeProceduresFormSubmission {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result Json

  status FormSubmissionStatus @default(PENDING)

  remarks            String?
  handleAt           DateTime?
  handleByOperatorId String?   @db.Uuid

  // Relations
  formId String                       @db.Uuid
  form   AdministrativeProceduresForm @relation(fields: [formId], references: [id])

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id])

  handleBy Operator? @relation(fields: [handleByOperatorId], references: [id])
  
  // Blockchain signature relation
  formSignatureOnChain FormSignatureOnChain?
}

enum FormSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Event management models
model Event {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String
  startTime   DateTime
  endTime     DateTime
  location    String
  capacity    Int
  isPublished Boolean  @default(false)
  imageUrl    String?

  // Additional event information
  category             String?
  registrationDeadline DateTime?
  requireApproval      Boolean   @default(false)
  metadata             Json?

  // Relations
  createdByOperatorId String              @db.Uuid
  createdBy           Operator            @relation(fields: [createdByOperatorId], references: [id])
  registrations       EventRegistration[]

  @@index([startTime, endTime])
}

model EventRegistration {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status EventRegistrationStatus @default(PENDING)

  handleAt       DateTime?
  remarks        String?
  additionalInfo Json?

  // Relations
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id])

  handleByOperatorId String?   @db.Uuid
  handleBy           Operator? @relation("EventRegistrationHandler", fields: [handleByOperatorId], references: [id])

  @@unique([eventId, studentId])
  @@index([eventId, status])
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ATTENDED
}

// Blockchain Transaction models
enum BlockchainType {
  SOLANA
  POLYGON
  ETHEREUM
}

enum BlockchainTransactionType {
  FORM_SIGN
  FORM_SIGNATURE
  NFT_MINT
  REWARD_TRANSFER
}

enum BlockchainTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model BlockchainTransaction {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  txHash          String
  chain           BlockchainType
  txType          BlockchainTransactionType
  status          BlockchainTransactionStatus @default(PENDING)
  senderAddress   String
  receiverAddress String?
  executedAt      DateTime?
  metadata        Json?

  // Relations
  formSignatures FormSignatureOnChain[]
  
  // User relation - for tracking who initiated the transaction
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])
  
  @@index([txHash])
  @@index([chain, txType, status])
  @@index([userId])
}

model FormSignatureOnChain {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formHash String

  // Relations
  formSubmissionId String                                @unique @db.Uuid
  formSubmission   AdministrativeProceduresFormSubmission @relation(fields: [formSubmissionId], references: [id])

  transactionId String                @db.Uuid
  transaction   BlockchainTransaction @relation(fields: [transactionId], references: [id])

  @@index([formHash])
}

// Notification model for user notifications
model Notification {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  content     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  type        NotificationType
  metadata    Json?     // Additional metadata for the notification
  
  // Relations
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum NotificationType {
  SYSTEM
  ROOM_BOOKING
  EVENT
  FORM_STATUS
  BLOCKCHAIN_TRANSACTION
}
