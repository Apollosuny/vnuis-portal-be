{
  "name": "cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "dev": "",
    "cdk:bootstrap:dev": "cdk bootstrap --app \"npx ts-node --prefer-ts-exts bin/cdk.dev.ts\" --profile apollo-cli",
    "deploy:cicd_dev": "ENV=dev cdk deploy --app \"npx ts-node --prefer-ts-exts bin/cdk.dev.ts\" --outputs-file ./cdk-output/cdk-dev-outputs.json",
    "deploy:cicd_prd": "ENV=dev cdk deploy --app \"npx ts-node --prefer-ts-exts bin/cdk.prd.ts\" --outputs-file ./cdk-output/cdk-prd-outputs.json",
    "deploy:local": "ENV=dev cdk deploy --app \"npx ts-node --prefer-ts-exts bin/cdk.dev.ts\" --profile apollo-cli --outputs-file ./cdk-output/cdk-dev-outputs.json",
    "deploy:quick": "cd ../nest && pnpm build && cd ../cdk && pnpm deploy:local",
    "cdk:synth:dev": "cdk synth --no-staging --app \"npx ts-node --prefer-ts-exts bin/cdk.dev.ts\" --profile apollo-cli > ./cdk-templates/template_dev.yaml",
    "cdk:synth:prd": "cdk synth --no-staging --app \"npx ts-node --prefer-ts-exts bin/cdk.prd.ts\" --profile apollo-cli > ./cdk-templates/template_prd.yaml"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.11.30",
    "aws-cdk": "^2.178.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.136.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}